# ─────────────────────────────────────────────────────────────────────────────
# Parasite — environment configuration
# Copy to `.env` and fill in. Every value here has a working default or a
# documented fallback, so the game runs with NO configuration at all.
# ─────────────────────────────────────────────────────────────────────────────

# ── Multiplayer server ───────────────────────────────────────────────────────
# Bound to 127.0.0.1 by default. Do not expose publicly without adding auth.
PORT=9101
HOST=127.0.0.1

# Public URL the browser uses to reach the Socket.io server.
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:9101

# ── Chain / Inco ─────────────────────────────────────────────────────────────
# Base Sepolia. Chain id 84532.
NEXT_PUBLIC_CHAIN_ID=84532

# TODO: No RPC credential was provided for this build. The public Base
# Sepolia RPC below is rate-limited and will throttle under load. For a real
# demo, set this to an Alchemy/Infura/QuickNode Base Sepolia HTTPS URL.
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org

# TODO: Address of the deployed ParasiteGame contract. EMPTY = the app
# runs in SIMULATED role mode (LocalRoleOracle) and says so in the HUD.
# Fill this in after running: npm run deploy:baseSepolia
NEXT_PUBLIC_PARASITE_GAME_ADDRESS=

# TODO: Deployer private key. REQUIRED to deploy the contracts and NOT
# provided with this build, so no deployment was performed. Needs a funded Base
# Sepolia account (faucet: https://www.alchemy.com/faucets/base-sepolia).
# Never commit this. 0x-prefixed, 64 hex chars.
DEPLOYER_PRIVATE_KEY=

# Optional: Basescan key for `verify`. Not required to deploy.
BASESCAN_API_KEY=
